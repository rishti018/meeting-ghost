# Meeting Ghost - Global Environment Configuration Example
# Copy to server/.env or .env and configure directly

# Server Configuration
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# Database Configuration (MongoDB Atlas using Mongoose)
# Example Atlas URI: mongodb+srv://rishti018_db_user:Bk5MGffKmLiiIPwR@cluster0.mongodb.net/meeting_ghost?retryWrites=true&w=majority
# Or local URI: mongodb://localhost:27017/meeting_ghost
MONGODB_URI=mongodb+srv://rishti018_db_user:Bk5MGffKmLiiIPwR@cluster0.3phugf6.mongodb.net/meeting_ghost?retryWrites=true&w=majority
MONGODB_DB_NAME=meeting_ghost

# Google Gemini API Key (Official @google/genai SDK)
# Get your API key from Google AI Studio: https://aistudio.google.com/
GEMINI_API_KEY=AQ.Ab8RN6KvCtT97fERUVlYlMVrfomrt_EhXLa2bnRxojfq3d2DLA
GEMINI_MODEL=gemini-2.5-flash

# Audio Upload & Transcription Configuration
# Maximum allowable audio upload size in megabytes (default: 25)
MAX_AUDIO_SIZE_MB=25
